#!/bin/bash
# Start MetaTrader 5 again whenever it is not running.
# MT5_WATCHDOG_INTERVAL: seconds between checks (default 60, 0 disables).
source /usr/local/lib/mt5/common.sh

# One watchdog per container, even if the desktop session restarts.
mt5_lock /tmp/mt5-watchdog.lock -n

mt5_log_to /config/mt5-watchdog.log

INTERVAL="${MT5_WATCHDOG_INTERVAL:-60}"
if ! [[ "$INTERVAL" =~ ^[0-9]+$ ]]; then
    mt5_log "Invalid MT5_WATCHDOG_INTERVAL '$INTERVAL', using 60"
    INTERVAL=60
fi
if [ "$INTERVAL" -eq 0 ]; then
    mt5_log "Disabled"
    exit 0
fi

mt5_log "Checking every ${INTERVAL}s"
while sleep "$INTERVAL"; do
    # Skip while mt5-install runs: it starts the terminal itself.
    if [ -f "$MT5_EXE" ] && ! mt5_running && flock -n "$MT5_INSTALL_LOCK" true; then
        mt5_log "MetaTrader 5 is not running, starting it"
        mt5_start
    fi
done
