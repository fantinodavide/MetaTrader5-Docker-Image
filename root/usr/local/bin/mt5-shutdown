#!/bin/bash
# Close MetaTrader 5 the way File > Exit does, then let Wine shut down, so both
# write their state to disk. Called by the svc-mt5-shutdown s6 service on
# container stop.
source /usr/local/lib/mt5/common.sh

# Keeps the watchdog from starting the terminal again once it has closed.
# Gives up after 10s if mt5-install is still running.
mt5_lock "$MT5_INSTALL_LOCK" -w 10
# In the volume: docker logs go away with the container on a redeploy.
mt5_log_to /config/mt5-shutdown.log

if mt5_running; then
    mt5_log "Closing MetaTrader 5"
    # Without /f, taskkill asks the terminal's windows to close.
    wine taskkill /im terminal64.exe
    for _ in $(seq 30); do
        mt5_running || break
        sleep 1
    done
    if mt5_running; then
        mt5_log "MetaTrader 5 did not close within 30s"
    else
        mt5_log "MetaTrader 5 closed"
    fi
fi

# wineserver writes the registry to disk only when it exits, which it does
# once the last Wine process has ended. The desktop's shutdown kills it
# before that, and MT5 then deletes its saved accounts "due security reason"
# at the next start.
if timeout 15 wineserver -w; then
    mt5_log "Wine shut down"
else
    mt5_log "Wine did not shut down within 15s"
fi
