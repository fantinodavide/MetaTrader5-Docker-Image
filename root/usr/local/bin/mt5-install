#!/bin/bash

# MetaTrader 5 Installation Script
# Runs via desktop autostart after the display is ready

# Configuration
MT5_FILE="/config/.wine/drive_c/Program Files/MetaTrader 5/terminal64.exe"
MT5_SETUP_URL="https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe"

# Export Wine environment
export WINEPREFIX="/config/.wine"
export WINEDEBUG="-all"
export HOME="/config"

# Log function
log() {
    echo "[MT5] $1"
    notify-send "MetaTrader 5" "$1" 2>/dev/null || true
}

log "Starting MetaTrader 5 setup..."

# Ensure Wine directories exist
mkdir -p /config/.wine /config/.cache

# Initialize Wine prefix if it doesn't exist
if [ ! -d "$WINEPREFIX/drive_c" ]; then
    log "Initializing Wine prefix..."
    wineboot --init
    sleep 10
fi

# Install core fonts if not done
if [ ! -f "$WINEPREFIX/.fonts_installed" ]; then
    log "Installing fonts (this may take a while)..."
    winetricks -q corefonts tahoma 2>/dev/null || true
    touch "$WINEPREFIX/.fonts_installed"
    log "Fonts installed."
fi

# Configure Wine registry
if [ ! -f "$WINEPREFIX/.registry_configured" ]; then
    log "Configuring Wine..."
    wine reg add "HKEY_CURRENT_USER\\Control Panel\\Desktop" /v FontSmoothing /t REG_SZ /d "2" /f 2>/dev/null || true
    wine reg add "HKEY_CURRENT_USER\\Control Panel\\Desktop" /v FontSmoothingType /t REG_DWORD /d 2 /f 2>/dev/null || true
    wine reg add "HKEY_CURRENT_USER\\Software\\Wine" /v Version /t REG_SZ /d "win10" /f 2>/dev/null || true
    touch "$WINEPREFIX/.registry_configured"
fi

# Install MetaTrader 5 if not present
if [ ! -f "$MT5_FILE" ]; then
    log "Downloading MetaTrader 5..."
    curl -sL -o /tmp/mt5setup.exe "$MT5_SETUP_URL"

    log "Installing MetaTrader 5 (please wait)..."
    wine /tmp/mt5setup.exe /auto
    rm -f /tmp/mt5setup.exe

    # Wait for installation
    for i in {1..60}; do
        if [ -f "$MT5_FILE" ]; then
            log "MetaTrader 5 installed successfully!"
            break
        fi
        sleep 5
    done
fi

# Launch MetaTrader 5
if [ -f "$MT5_FILE" ]; then
    log "Launching MetaTrader 5..."
    wine "$MT5_FILE" &
else
    log "MT5 not found. Please install manually."
fi
