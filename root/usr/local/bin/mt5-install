#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# MetaTrader 5 Installation Script
# This script installs and configures MT5 in a 64-bit Wine prefix

# Configuration
MT5_FILE="/config/.wine/drive_c/Program Files/MetaTrader 5/terminal64.exe"
MT5_SETUP_URL="https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe"

# Export Wine environment
export WINEPREFIX="/config/.wine"
export WINEDEBUG="-all"
export DISPLAY=":1"
export HOME="/config"

echo "[MT5] Starting MetaTrader 5 setup..."

# Wait for X server to be available
echo "[MT5] Waiting for display to be ready..."
for i in {1..60}; do
    if xdpyinfo -display :1 >/dev/null 2>&1; then
        echo "[MT5] Display is ready."
        break
    fi
    echo "[MT5] Waiting for display... ($i/60)"
    sleep 2
done

if ! xdpyinfo -display :1 >/dev/null 2>&1; then
    echo "[MT5] ERROR: Display not available after 2 minutes. Exiting."
    exit 1
fi

# Ensure /config/.wine exists and has correct ownership
mkdir -p /config/.wine /config/.cache
chown -R abc:abc /config/.wine /config/.cache 2>/dev/null || true

# Function to run commands as abc user
run_as_abc() {
    s6-setuidgid abc "$@"
}

# Initialize Wine prefix if it doesn't exist
if [ ! -d "$WINEPREFIX/drive_c" ]; then
    echo "[MT5] Initializing 64-bit Wine prefix..."
    run_as_abc wineboot --init
    sleep 10
fi

# Install core fonts if not done
if [ ! -f "$WINEPREFIX/.fonts_installed" ]; then
    echo "[MT5] Installing Microsoft Core Fonts..."
    run_as_abc winetricks -q corefonts tahoma 2>/dev/null || true
    touch "$WINEPREFIX/.fonts_installed"
    chown abc:abc "$WINEPREFIX/.fonts_installed"
    echo "[MT5] Fonts installed."
fi

# Configure Wine registry for font smoothing
if [ ! -f "$WINEPREFIX/.registry_configured" ]; then
    echo "[MT5] Configuring Wine registry..."
    run_as_abc wine reg add "HKEY_CURRENT_USER\\Control Panel\\Desktop" /v FontSmoothing /t REG_SZ /d "2" /f 2>/dev/null || true
    run_as_abc wine reg add "HKEY_CURRENT_USER\\Control Panel\\Desktop" /v FontSmoothingType /t REG_DWORD /d 2 /f 2>/dev/null || true
    run_as_abc wine reg add "HKEY_CURRENT_USER\\Software\\Wine" /v Version /t REG_SZ /d "win10" /f 2>/dev/null || true
    touch "$WINEPREFIX/.registry_configured"
    chown abc:abc "$WINEPREFIX/.registry_configured"
    echo "[MT5] Registry configured."
fi

# Install MetaTrader 5 if not present
if [ ! -f "$MT5_FILE" ]; then
    echo "[MT5] Downloading MetaTrader 5..."
    curl -sL -o /tmp/mt5setup.exe "$MT5_SETUP_URL"
    chown abc:abc /tmp/mt5setup.exe
    echo "[MT5] Installing MetaTrader 5 (this may take a few minutes)..."
    run_as_abc wine /tmp/mt5setup.exe /auto
    rm -f /tmp/mt5setup.exe

    # Wait for installation to complete
    echo "[MT5] Waiting for installation to complete..."
    for i in {1..60}; do
        if [ -f "$MT5_FILE" ]; then
            echo "[MT5] MetaTrader 5 installed successfully."
            break
        fi
        sleep 5
    done

    if [ ! -f "$MT5_FILE" ]; then
        echo "[MT5] Warning: MT5 installation may not have completed. Check manually."
    fi
else
    echo "[MT5] MetaTrader 5 is already installed."
fi

# Launch MetaTrader 5
if [ -f "$MT5_FILE" ]; then
    echo "[MT5] Launching MetaTrader 5..."
    run_as_abc wine "$MT5_FILE" &
else
    echo "[MT5] MetaTrader 5 not found. Please install manually via VNC."
fi

echo "[MT5] Setup complete."
