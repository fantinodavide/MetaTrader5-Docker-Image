#!/bin/bash
# Sets up the Wine prefix, installs MetaTrader 5 on first run and starts it.
# Runs from XDG autostart on every desktop session start, so every step is
# idempotent.
source /usr/local/lib/mt5/common.sh

MT5_SETUP_URL="https://download.mql5.com/cdn/web/metaquotes.software.corp/mt5/mt5setup.exe"

# Serialises overlapping session starts and keeps the watchdog away.
mt5_lock "$MT5_INSTALL_LOCK"
mt5_log_to /config/mt5-install.log

mt5_log "Starting (user=$(whoami), display=$DISPLAY)"

# Older images used a 32-bit prefix, which can't run terminal64.exe. Move it
# aside instead of deleting it: it holds the user's accounts and MQL5 code.
if grep -qs '^#arch=win32' "$WINEPREFIX/system.reg"; then
    backup="$WINEPREFIX.win32-$(date +%Y%m%d%H%M%S)"
    mt5_log "Found a 32-bit Wine prefix, moving it to $backup"
    mv "$WINEPREFIX" "$backup"
fi

if [ ! -f "$WINEPREFIX/system.reg" ]; then
    mt5_log "Creating Wine prefix"
    wineboot --init
    wineserver -w
fi

if [ ! -f "$WINEPREFIX/.registry_configured" ]; then
    mt5_log "Configuring Wine registry"
    wine reg add 'HKCU\Control Panel\Desktop' /v FontSmoothing /t REG_SZ /d 2 /f &&
        wine reg add 'HKCU\Software\Wine' /v Version /t REG_SZ /d win10 /f &&
        touch "$WINEPREFIX/.registry_configured"
fi

mkdir -p /config/Desktop
install -m 755 /usr/share/applications/metatrader5.desktop /config/Desktop/

# Launchers that Wine generated for this terminal in older versions call wine
# without our environment; point them at mt5-launch.
grep -lsE '^Exec=env WINEPREFIX=.*MetaTrader\\* 5\\+terminal64\.exe' /config/Desktop/*.desktop | while read -r f; do
    sed -i 's|^Exec=.*|Exec=/usr/local/bin/mt5-launch|' "$f"
    mt5_log "Fixed launcher $f"
done
# Superseded by /usr/share/applications/wine.desktop in the image.
f=/config/.local/share/applications/wine.desktop
grep -qsx 'Exec=env WINEPREFIX=/config/.wine wine %f' "$f" && rm -f "$f"

if [ ! -f "$MT5_EXE" ]; then
    setup=/tmp/mt5setup.exe
    mt5_log "Downloading MetaTrader 5"
    if curl -fsSL --retry 5 --retry-delay 10 -o "$setup" "$MT5_SETUP_URL"; then
        mt5_log "Running the installer, this takes a few minutes"
        wine "$setup" /auto
        rm -f "$setup"
        # The installer can return before the terminal is on disk.
        for _ in $(seq 60); do
            [ -f "$MT5_EXE" ] && break
            sleep 5
        done
    fi
    if [ ! -f "$MT5_EXE" ]; then
        mt5_log "ERROR: installation failed, it will be retried on the next start"
        exit 1
    fi
    mt5_log "Installed"
fi

# The Strategy Tester fails with "open error [3]" when these are missing.
mkdir -p "$MT5_DIR"/Tester/{bases,cache,logs}

if mt5_running; then
    mt5_log "MetaTrader 5 is already running"
else
    mt5_log "Starting MetaTrader 5"
    mt5_start
fi
