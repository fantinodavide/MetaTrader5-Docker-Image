#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# The base image only chowns the top of /config. After a PUID/PGID change, or
# data copied in as root, files left with another owner break both Wine
# ("not owned by you") and the desktop session. -xdev leaves bind mounts alone.
find /config -xdev \( ! -user abc -o ! -group abc \) -exec chown -h abc:abc {} +
