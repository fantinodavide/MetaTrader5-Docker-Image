#!/usr/bin/with-contenv bash
# shellcheck shell=bash

# Wait for MT5 installation to complete
sleep 10

# Export Wine environment
export WINEPREFIX="/config/.wine"
export WINEDEBUG="-all"
export DISPLAY=":1"
export HOME="/config"

# Start mt5linux API server as abc user
exec s6-setuidgid abc python3 -m mt5linux --host 0.0.0.0 -p 8001 -w wine python.exe
