# MetaTrader 5 Docker Configuration

# User/Group IDs (match your host user for proper file permissions)
PUID=1000
PGID=1000

# Timezone
TZ=Etc/UTC

# Port mappings (change if running multiple instances)
VNC_PORT=3000
API_PORT=8001

# Optional: VNC credentials (for KasmVNC)
# CUSTOM_USER=username
# PASSWORD=securepassword
