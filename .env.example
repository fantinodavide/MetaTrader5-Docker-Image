# MetaTrader 5 Docker configuration. Copy to .env and adjust.

# User/group IDs that own the files in the volume
PUID=1000
PGID=1000

TZ=Etc/UTC

# Web desktop login (no login when PASSWORD is empty)
# CUSTOM_USER=username
# PASSWORD=securepassword

# Browser tab / PWA name
# TITLE=MetaTrader 5

# Desktop scaling: 96 = 100%, 120 = 125%, 144 = 150% (steps of 24, up to 288)
# SELKIES_SCALING_DPI=96

# Seconds between watchdog checks, 0 disables the watchdog
# MT5_WATCHDOG_INTERVAL=60

# Extra command line options for terminal64.exe
# MT5_CMD_OPTIONS=
